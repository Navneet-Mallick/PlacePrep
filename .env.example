# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: keep DB_ENGINE=sqlite
# Production (Render + Supabase): switch to postgresql and fill in the rest
DB_ENGINE=sqlite
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_db_password
# DB_HOST=db.xxxx.supabase.co
# DB_PORT=5432

# ── ML service (FastAPI) ──────────────────────────────────────────────────────
# Local dev
ML_API_URL=http://localhost:8001/api
# Production (set to your Render ML service URL)
# ML_API_URL=https://placeprep-ml.onrender.com/api

# ── CORS ──────────────────────────────────────────────────────────────────────
# Leave empty for local dev (defaults to localhost:5173 and localhost:3000)
# Production: set to your Vercel URL
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Gemini API (optional) ─────────────────────────────────────────────────────
# Used for AI resume recommendations. App works without it (uses fallback scoring).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend (create frontend/.env.local for Vite local dev) ─────────────────
# VITE_API_URL=http://localhost:8000/api
# VITE_ML_API_URL=http://localhost:8001/api
# Production: set these in Vercel dashboard environment variables
# VITE_API_URL=https://placeprep-backend.onrender.com/api
# VITE_ML_API_URL=https://placeprep-ml.onrender.com/api
